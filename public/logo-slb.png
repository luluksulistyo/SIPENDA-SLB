<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="500" height="500">
  <defs>
    <path id="textPath" d="M 60,250 A 190,190 0 0,1 440,250" />
  </defs>
  <!-- Outer Shield / Octagon background -->
  <polygon points="150,20 350,20 480,150 480,350 350,480 150,480 20,350 20,150" fill="#00b4ff" stroke="#ffde00" stroke-width="14" />
  
  <!-- Inner Circle -->
  <circle cx="250" cy="250" r="160" fill="#89d9ff" stroke="#ffffff" stroke-width="6" />
  
  <!-- Muhammadiyah Sun Symbol (Green/Blue/White) -->
  <g transform="translate(250,235)">
    <!-- Rays -->
    <circle cx="0" cy="0" r="95" fill="#2b388f" />
    <path d="M 0,-125 L 15,-90 L 0,-105 L -15,-90 Z" fill="#2b388f" />
    <path d="M 88,-88 L 65,-65 L 78,-78 L 65,-90 Z" fill="#2b388f" />
    <path d="M 125,0 L 90,-15 L 105,0 L 90,15 Z" fill="#2b388f" />
    <path d="M 88,88 L 65,65 L 90,65 L 78,78 Z" fill="#2b388f" />
    <path d="M 0,125 L 15,90 L 0,105 L -15,90 Z" fill="#2b388f" />
    <path d="M -88,88 L -65,65 L -78,78 L -65,90 Z" fill="#2b388f" />
    <path d="M -125,0 L -90,-15 L -105,0 L -90,15 Z" fill="#2b388f" />
    <path d="M -88,-88 L -65,-65 L -90,-65 L -78,-78 Z" fill="#2b388f" />
    
    <circle cx="0" cy="0" r="70" fill="#ffffff" />
    <!-- Arabic Calligraphy placeholder / stylized -->
    <text x="0" y="10" font-family="serif" font-size="28" font-weight="bold" fill="#2b388f" text-anchor="middle">محمد رسول الله</text>
  </g>

  <!-- Text Top -->
  <text font-family="Arial, sans-serif" font-weight="bold" font-size="32" fill="#ffffff" stroke="#000000" stroke-width="1.5">
    <textPath href="#textPath" startOffset="50%" text-anchor="middle">SLB MUHAMMADIYAH PONJONG</textPath>
  </text>

  <!-- Bottom Ribbon -->
  <path d="M 100,380 Q 250,450 400,380 L 375,430 Q 250,490 125,430 Z" fill="#ffde00" stroke="#000000" stroke-width="2" />
  <text x="250" y="420" font-family="Arial, sans-serif" font-weight="bold" font-size="28" fill="#000000" text-anchor="middle">PONJONG</text>
</svg>
